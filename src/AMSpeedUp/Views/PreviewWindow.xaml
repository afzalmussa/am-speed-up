<Window x:Class="AMSpeedUp.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check before going ahead"
        Icon="pack://application:,,,/AMSpeedUp;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="680" Height="640" MinWidth="460" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <!-- Safety rule 1: everything that will happen, listed before the user agrees. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,16">
                <TextBlock x:Name="TitleBlock" Style="{StaticResource HeadingText}" FontSize="23" />
                <TextBlock x:Name="IntroBlock" Style="{StaticResource BodyText}" Margin="0,8,0,0" />

                <!-- Test mode and restore point notices -->
                <ItemsControl x:Name="NoticesList" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- One card per kind of undo, most reversible first -->
                <ItemsControl x:Name="SectionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,8,0,0">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="&#x2713;" FontWeight="Bold" FontSize="17"
                                                               Foreground="{StaticResource LinkBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Summary}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="15">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="Text" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </Trigger>
                                                                        <Trigger Property="Text" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding UndoNote}" FontStyle="Italic" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Anything refused because it's on the protected list -->
                <StackPanel x:Name="BlockedPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="BlockedHeading" Style="{StaticResource SubheadingText}" FontSize="17" />
                    <ItemsControl x:Name="BlockedList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3">
                                    <Run Text="{Binding Action.Summary, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <WrapPanel HorizontalAlignment="Right">
                <!-- Escape cancels. Enter does nothing here, so nobody confirms by accident. -->
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,4,10,4" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="0,4,0,4" Click="Confirm_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
