<UserControl x:Class="AMSpeedUp.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMSpeedUp.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource HeadingText}" Text="Choose what starts with your PC" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,6"
                       Text="Some programs start every time you turn on your PC, which can make it slow to get going. Switching one off doesn't remove it. It just stops it starting by itself, and you can still open it whenever you like." />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,20" FontSize="15"
                       Text="You can switch anything back on here at any time. Changes also show in Task Manager, and apply the next time you start your PC." />

            <!-- Working -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding BusyText}" FontWeight="SemiBold" />
                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,14,0,0" Foreground="{StaticResource MintBrush}"
                                 Background="{StaticResource LightBrush}" BorderThickness="0" AutomationProperties.Name="Working, please wait" />
                </StackPanel>
            </Border>

            <!-- What happened last time -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource MintBrush}" BorderThickness="2"
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="What happened" />
                    <ItemsControl ItemsSource="{Binding Summary}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyText}" Text="&#x2022;" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Nothing starts -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource BodyText}" Text="Nothing extra starts with Windows on this PC." />
            </Border>

            <!-- The list -->
            <StackPanel Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding CountText}" Margin="0,0,0,8" />

                <Border Style="{StaticResource Card}" Padding="24,8">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <WrapPanel>
                                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <Border Style="{StaticResource Pill}" Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding AdviceText}" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="15" Text="{Binding Explanation}" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Text="{Binding DetailsText}" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="14" FontStyle="Italic" Text="{Binding ProtectionText}"
                                                       Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanChange}"
                                                      AutomationProperties.Name="{Binding DisplayName, StringFormat=Start {0} with Windows}" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Text="{Binding StateText}"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <WrapPanel Margin="0,20,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyButtonText}" Command="{Binding ApplyChangesCommand}" Margin="0,0,12,8" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Undo my changes" Command="{Binding ResetChangesCommand}" Margin="0,0,12,8" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Style="{StaticResource MutedText}" FontSize="15" Margin="0,4,0,0"
                           Text="You'll see a list of your changes to check before anything is saved." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
