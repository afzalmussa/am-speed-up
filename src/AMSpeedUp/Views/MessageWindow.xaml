<Window x:Class="AMSpeedUp.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AM Speed Up"
        Icon="pack://application:,,,/AMSpeedUp;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="520" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- A simple, readable replacement for the standard Windows message box. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <TextBlock x:Name="HeadingBlock" Style="{StaticResource SubheadingText}" />
                <TextBlock x:Name="MessageBlock" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <Button Content="OK" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Ok_Click" />
        </Border>
    </Grid>
</Window>
