<Window x:Class="AMSpeedUp.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AMSpeedUp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="About AM Speed Up"
        Icon="pack://application:,,,/AMSpeedUp;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="560" Height="640" MinWidth="420" MinHeight="400"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,16">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/AMSpeedUp;component/Assets/logo.png" Width="72" Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="AM Software logo" />
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource HeadingText}" Text="{Binding ProductName}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding VersionText}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource BodyText}" Margin="0,20,0,0"
                           Text="AM Speed Up is made by AM Software, a small computer repair business. It helps you speed up your PC by removing programs you don't need, choosing what starts with Windows and clearing out clutter." />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0"
                           Text="Nothing on your PC changes until you've seen exactly what will happen and said yes." />

                <WrapPanel Margin="0,20,0,0">
                    <Button Content="Visit amsoftware.uk" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenWebsiteCommand}" Margin="0,0,10,10" />
                    <Button Content="Get help" Style="{StaticResource SecondaryButton}"
                            Command="{Binding GetHelpCommand}" Margin="0,0,10,10" />
                </WrapPanel>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20"
                        Visibility="{Binding CanDonate, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheadingText}" Text="Enjoying AM Speed Up?" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,12"
                                   Text="The free version will always be free. If it's helped you, you can support its development with a small donation." />
                        <Button Content="Donate" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Command="{Binding DonateCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SubheadingText}" Text="Updates and source code" Margin="0,24,0,4" />
                <WrapPanel>
                    <Button Content="Check for updates" Style="{StaticResource LinkButton}"
                            Command="{Binding CheckForUpdatesCommand}" Margin="0,0,16,0" />
                    <Button Content="Source code on GitHub" Style="{StaticResource LinkButton}"
                            Command="{Binding OpenSourceCodeCommand}" Margin="0,0,16,0" />
                    <Button Content="Report a problem" Style="{StaticResource LinkButton}"
                            Command="{Binding ReportProblemCommand}" />
                </WrapPanel>

                <TextBlock Style="{StaticResource MutedText}" FontSize="14" LineHeight="20" Margin="0,16,0,0"
                           Text="Copyright (c) 2026 Afzal Mussa, trading as AM Software. This app is free for anyone to use, including businesses. The source code is published under the PolyForm Noncommercial License 1.0.0. Headings use the JetBrains Mono font, licensed under the SIL Open Font License 1.1." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="32,12">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    IsCancel="True" IsDefault="True" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
