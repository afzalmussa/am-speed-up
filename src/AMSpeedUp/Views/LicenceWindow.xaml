<Window x:Class="AMSpeedUp.Views.LicenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AMSpeedUp.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LicenceViewModel}"
        Title="Your licence"
        Icon="pack://application:,,,/AMSpeedUp;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="600" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="23" Text="Your licence" />
                    <Border Style="{StaticResource ProBadge}" Margin="14,6,0,0">
                        <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource MintBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" Text="{Binding Description}" />

                <!-- Saved licence details -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowManage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="15" Text="{Binding MaskedKey}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="15" Text="{Binding ActivationsText}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="15" Text="{Binding LastCheckedText}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Check now" Command="{Binding CheckNowCommand}" Margin="0,0,10,8" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Remove this PC" Command="{Binding RemoveThisPcCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="14"
                               Text="Getting a new PC? Click &quot;Remove this PC&quot; here first, then enter your key on the new PC." />
                </StackPanel>

                <!-- Enter a key -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20"
                        Visibility="{Binding ShowKeyEntry, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubheadingText}" FontSize="17" Text="Enter your licence key" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="15" Margin="0,4,0,10"
                                   Text="It's in the email you got after buying AM Speed Up Pro. Copy it and paste it here." />
                        <TextBox x:Name="KeyBox" Text="{Binding KeyText, UpdateSourceTrigger=PropertyChanged}" FontSize="17" Padding="10,8"
                                 FontFamily="Consolas, Segoe UI" BorderBrush="{StaticResource TextBrush}" BorderThickness="1"
                                 AutomationProperties.Name="Licence key" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Activate" Command="{Binding ActivateCommand}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" IsDefault="True" />
                    </StackPanel>
                </Border>

                <!-- Result of the last thing the user did -->
                <Border Margin="0,16,0,0" CornerRadius="6" Padding="14,10" BorderThickness="1"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsGood}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource MintBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Message}" />
                </Border>

                <!-- Buy -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding CanBuy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource BodyText}" Text="Haven't got a key yet?" FontWeight="SemiBold" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Get AM Speed Up Pro" Command="{Binding GetProCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>

                <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,18,0,0"
                           Text="Checking a licence sends only the key and a random label for this PC to Lemon Squeezy, who sell AM Speed Up Pro. Nothing else about you or your PC is sent." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
