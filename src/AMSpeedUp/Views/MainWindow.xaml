<Window x:Class="AMSpeedUp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AMSpeedUp.ViewModels"
        xmlns:views="clr-namespace:AMSpeedUp.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AM Speed Up"
        Icon="pack://application:,,,/AMSpeedUp;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="1040" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: logo, name, free/Pro status and licence button -->
        <Border Grid.Row="0" Background="{StaticResource DarkBrush}" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/AMSpeedUp;component/Assets/logo-on-dark.png"
                           Width="52" Height="52" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="AM Software logo" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="Bold" FontSize="24" Foreground="{StaticResource OnDarkTextBrush}" />
                        <TextBlock Text="Make your PC faster, safely" FontSize="15"
                                   Foreground="{StaticResource OnDarkMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border BorderBrush="{StaticResource MintBrush}" BorderThickness="1" CornerRadius="16"
                            Padding="14,5" Margin="0,4,12,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LicenceStatusText}" Foreground="{StaticResource MintBrush}"
                                   FontWeight="SemiBold" FontSize="15" />
                    </Border>
                    <Button Content="Get Pro" Style="{StaticResource PrimaryButton}"
                            Command="{Binding GetProCommand}" Margin="0,4,10,4"
                            Visibility="{Binding CanGetPro, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Enter licence key" Style="{StaticResource HeaderButton}"
                            Command="{Binding EnterLicenceKeyCommand}" Margin="0,4,10,4" />
                    <Button Content="About" Style="{StaticResource HeaderButton}"
                            Command="{Binding ShowAboutCommand}" Margin="0,4,0,4" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Only shown when started with dry-run, so it's obvious nothing will really change -->
        <Border Grid.Row="1" Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="0,0,0,2" Padding="24,10"
                Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                       Text="Test mode is on. The app will show what it would do, but nothing on this PC will be changed." />
        </Border>

        <!-- Pro toolbar: shown to everyone, explains Pro when clicked on the free version -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,10" DataContext="{Binding ProTools}"
                Visibility="{Binding DataContext.HasProTools, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="{StaticResource DarkBrush}" CornerRadius="12" Padding="10,3"
                        Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="Pro" Foreground="{StaticResource MintBrush}" FontWeight="Bold" FontSize="14" />
                </Border>
                <Button DockPanel.Dock="Left" Content="Do everything recommended" Style="{StaticResource PrimaryButton}"
                        Command="{Binding DoEverythingCommand}" Margin="0,0,10,0"
                        ToolTip="Checks all three tabs and shows everything recommended in one preview before anything changes." />
                <Button DockPanel.Dock="Left" Content="Before and after report" Style="{StaticResource SecondaryButton}"
                        Command="{Binding MakeReportCommand}" Margin="0,0,14,0"
                        ToolTip="Saves a page in your Documents folder showing what changed while AM Speed Up was open." />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="3" Style="{StaticResource MainTabControl}" ItemContainerStyle="{StaticResource MainTabItem}">
            <TabItem Header="Remove bloat" AutomationProperties.Name="Remove bloat">
                <views:RemoveBloatView DataContext="{Binding RemoveBloat}" />
            </TabItem>

            <TabItem Header="Startup" AutomationProperties.Name="Startup">
                <views:StartupView DataContext="{Binding Startup}" />
            </TabItem>

            <TabItem Header="Free up space" AutomationProperties.Name="Free up space">
                <views:FreeSpaceView DataContext="{Binding FreeSpace}" />
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AM Software, " FontSize="15" VerticalAlignment="Center" />
                    <Button Content="amsoftware.uk" Style="{StaticResource LinkButton}" Command="{Binding OpenWebsiteCommand}"
                            Padding="0,6" />
                    <Button Content="Get help" Style="{StaticResource LinkButton}" Command="{Binding GetHelpCommand}"
                            Margin="16,0,0,0" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="View log" Style="{StaticResource LinkButton}" Command="{Binding ViewLogCommand}" Margin="0,0,14,0" />
                    <Button Content="Report a problem" Style="{StaticResource LinkButton}" Command="{Binding ReportProblemCommand}" Margin="0,0,14,0" />
                    <Button Content="Check for updates" Style="{StaticResource LinkButton}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
