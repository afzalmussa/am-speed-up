<Window x:Class="AMSpeedUp.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AM Speed Up"
        Icon="pack://application:,,,/AMSpeedUp;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="580" SizeToContent="Height" MaxHeight="680"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- A question or warning with up to three clearly labelled buttons. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Yellow strip across the top for warnings -->
        <Border x:Name="WarningStrip" Grid.Row="0" Height="6" Background="{StaticResource WarningBorderBrush}" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,20">
                <TextBlock x:Name="HeadingBlock" Style="{StaticResource SubheadingText}" />
                <TextBlock x:Name="BodyBlock" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
                <Button x:Name="ExtraButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Margin="0,18,0,0" Visibility="Collapsed" Click="Extra_Click" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}" Margin="0,4,10,4"
                        Visibility="Collapsed" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Margin="0,4,0,4"
                        IsDefault="True" Click="Primary_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
