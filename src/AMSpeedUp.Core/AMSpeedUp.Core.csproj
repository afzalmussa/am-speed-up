<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business logic, presets, licensing and service interfaces.
       No UI and no Windows-only APIs, so it builds and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AMSpeedUp.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\appsettings.json" LogicalName="AMSpeedUp.Core.appsettings.json" />
    <!-- The presets ship inside the app, so what's in the repo is exactly what the app removes. -->
    <EmbeddedResource Include="..\..\presets\*.json" Exclude="..\..\presets\preset.schema.json"
                      LogicalName="AMSpeedUp.Core.Presets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AMSpeedUp.Tests" />
  </ItemGroup>

</Project>
